{
  "name": "qa-bug-hunter-agent",
  "version": "1.0.0",
  "description": "Autonomous QA Testing Agent - Systematic exploratory testing with Playwright",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "sync-templates": "node scripts/sync-templates.mjs",
    "prebuild": "node scripts/sync-templates.mjs",
    "build": "tsc",
    "start": "node dist/cli.js",
    "predev": "node scripts/sync-templates.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node dist/cli.js --url https://example.com"
  },
  "keywords": [
    "qa",
    "testing",
    "automation",
    "playwright",
    "exploratory-testing",
    "bug-hunter"
  ],
  "author": "QA Bug Hunter",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.52.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
